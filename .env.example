# Required: choose one public search provider.
SEARCH_PROVIDER=serpapi
SERPAPI_API_KEY=replace_me

# Alternative provider:
# SEARCH_PROVIDER=google_cse
# GOOGLE_API_KEY=replace_me
# GOOGLE_CSE_ID=replace_me

# Optional but recommended for AI relevance ranking.
# Without this, the agent uses the built-in deterministic relevance scorer.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4.1-mini

# Optional tuning.
MAX_RESULTS=20
MAX_SEARCH_QUERIES=8
DAYS_BACK=3
COUNTRY=India
REQUEST_TIMEOUT_SECONDS=15

# Optional application automation controls.
# Auto-submission remains blocked for job boards such as LinkedIn, Naukri,
# Indeed, Glassdoor, Internshala, and Wellfound. Use allowlisted company/ATS
# domains only after confirming you have permission to submit there.
AUTO_APPLY_ENABLED=false
AUTO_APPLY_ALLOWED_DOMAINS=jobs.lever.co,boards.greenhouse.io,jobs.ashbyhq.com

# Optional cloud-held applicant profile for application draft generation.
# Keep sensitive values in GitHub Secrets, not committed files.
APPLICANT_PROFILE_JSON={"name":"Your Name","email":"you@example.com","phone":"+91XXXXXXXXXX","location":"India","summary":"Python/AI engineer with ML and backend experience.","skills":["Python","FastAPI","Machine Learning","LLMs","SQL"]}
RESUME_URL=https://example.com/resume.pdf
LOCAL_RESUME_PATH=/Users/harshmishra/Desktop/harshmishra.pdf

# Optional email delivery. If all SMTP fields are present, the generated
# spreadsheet is emailed as an attachment after every successful run.
NOTIFICATION_EMAIL_TO=harsh2mishra6@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
